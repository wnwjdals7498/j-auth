# Copy outside the checkout. Use: node --env-file=/absolute/path/server.env apps/server/dist/main.js
JAUTH_PORT=54231
JAUTH_DB_HOST=127.0.0.1
JAUTH_DB_PORT=54230
JAUTH_DB_NAME=jauth
JAUTH_DB_USER=jauth
JAUTH_DB_PASSWORD=__PLACEHOLDER_JAUTH_DB_PASSWORD__
JAUTH_TLS_CERTIFICATE=/absolute/runtime/tls/server.crt
JAUTH_TLS_KEY=/absolute/runtime/tls/server.key
NODE_EXTRA_CA_CERTS=/absolute/runtime/tls/ca.crt
KC_PUBLIC_URL=https://auth.jgw.test:8443
KC_ADMIN_URL=https://auth.jgw.test:8443
JGW_MASTER_J_AUTH_REALM_CREATOR_CLIENT_SECRET=__PLACEHOLDER_REALM_CREATOR_SECRET__
# SHA-256 digest of the console service key; never put its plaintext in j-auth env.
JAUTH_CONSOLE_KEY_HASH=__PLACEHOLDER_CONSOLE_KEY_SHA256__
